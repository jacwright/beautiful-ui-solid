{
  "name": "beautiful-ui-solid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom.ts",
    "./styles.css": "./src/styles/index.css",
    "./web.css": "./src/styles/web.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter docs dev",
    "build": "pnpm --filter docs build"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.3",
    "solid-js": "2.0.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
